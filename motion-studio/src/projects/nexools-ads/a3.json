 "captions": [
  {
   "t": 0.32,
   "text": "É golpe?",
   "end": 1.44
  },
  {
   "t": 1.44,
   "text": "Essa é a pergunta que mais recebemos.",
   "end": 4.3
  },
  {
   "t": 4.3,
   "text": "E ela é justa.",
   "end": 5.52
  },
  {
   "t": 5.52,
   "text": "Então eu vou responder diferente.",
   "end": 7.16
  },
  {
   "t": 7.16,
   "text": "A Nexools é uma revendedora independente.",
   "end": 9.74
  },
  {
   "t": 9.74,
   "text": "A gente não é o Coursera e",
   "end": 11.04
  },
  {
   "t": 11.04,
   "text": "não fala em nome dela.",
   "end": 12.32
  },
  {
   "t": 12.32,
   "text": "A conta vem no seu nome.",
   "end": 13.98
  },
  {
   "t": 13.98,
   "text": "Você troca a senha no primeiro acesso.",
   "end": 16.22
  },
  {
   "t": 16.22,
   "text": "Antes de pagar, você fala com uma",
   "end": 17.86
  },
  {
   "t": 17.86,
   "text": "pessoa de verdade no WhatsApp e pergunta",
   "end": 20.18
  },
  {
   "t": 20.18,
   "text": "tudo o que quiser.",
   "end": 20.98
  },
  {
   "t": 20.98,
   "text": "E você tem sete dias pra desistir,",
   "end": 23.04
  },
  {
   "t": 23.04,
   "text": "pelo Código de Defesa do Consumidor.",
   "end": 25.08
  },
  {
   "t": 25.08,
   "text": "Ainda ficou com dúvida?",
   "end": 26.14
  },
  {
   "t": 26.14,
   "text": "Toca em Saiba Mais e fala com",
   "end": 28.1
  },
  {
   "t": 28.1,
   "text": "a gente.",
