 "captions": [
  {
   "t": 0.5,
   "text": "O mesmo ano que custa mil e",
   "end": 2.35
  },
  {
   "t": 2.35,
   "text": "duzentos reais no site oficial,",
   "end": 4.76
  },
  {
   "t": 4.76,
   "text": "aqui, duzentos e noventa e sete.",
   "end": 6.96
  },
  {
   "t": 6.96,
   "text": "É o Coursera Plus,",
   "end": 8.54
  },
  {
   "t": 8.54,
   "text": "doze meses, milhares de cursos do Google,",
   "end": 11.58
  },
  {
   "t": 11.58,
   "text": "da IBM e da Meta,",
   "end": 13.12
  },
  {
   "t": 13.12,
   "text": "e de universidades como Stanford,",
   "end": 15.18
  },
  {
   "t": 15.18,
   "text": "com certificado no seu nome nos programas",
   "end": 17.87
  },
  {
   "t": 17.87,
   "text": "incluídos.",
   "end": 18.6
  },
  {
   "t": 18.6,
   "text": "E a conta é sua.",
   "end": 20.44
  },
  {
   "t": 20.44,
   "text": "Você troca a senha e coloca o",
   "end": 22.04
  },
  {
   "t": 22.04,
   "text": "seu nome.",
   "end": 22.88
  },
  {
   "t": 22.88,
   "text": "Não é conta compartilhada.",
   "end": 24.74
  },
  {
   "t": 24.74,
   "text": "Um pagamento só, em reais,",
   "end": 26.64
  },
  {
   "t": 26.64,
   "text": "no Pix ou no cartão.",
   "end": 28.44
  },
  {
   "t": 28.44,
   "text": "Sem mensalidade e sem renovação automática.",
   "end": 31.34
  },
  {
   "t": 31.34,
   "text": "E uma pessoa de verdade te atendendo",
   "end": 33.34
  },
  {
   "t": 33.34,
   "text": "no WhatsApp.",
   "end": 34.183
  },
  {
   "t": 34.183,
   "text": "Dá oitenta e um centavos por dia.",
   "end": 36.82
  },
  {
   "t": 36.82,
   "text": "Toca em Saiba Mais e assiste ao",
   "end": 38.76
  },
  {
   "t": 38.76,
   "text": "vídeo completo antes de decidir.",
   "end": 40.516
  }
